<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/casio_body"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp"
    tools:context=".MainActivity">

    <!-- CASIO + model -->
    <LinearLayout
        android:id="@+id/brand_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_brand_casio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="CASIO"
            android:textColor="@color/text_brand"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_brand_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="fx-880BTG"
            android:textColor="@color/text_brand"
            android:textSize="10sp"
            android:alpha="0.85" />
    </LinearLayout>

    <!-- LCD Screen -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="110dp"
        android:background="@drawable/bg_lcd_screen"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/brand_block">

        <GridLayout
            android:id="@+id/lcd_menu_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:useDefaultMargins="false"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:background="@drawable/bg_lcd_menu_selected"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Calculate"
                android:textColor="@color/lcd_menu_selected_fg"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Statistics"
                android:textColor="@color/lcd_menu_muted"
                android:textSize="8sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Distribution"
                android:textColor="@color/lcd_menu_muted"
                android:textSize="8sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Spreadsheet"
                android:textColor="@color/lcd_menu_muted"
                android:textSize="8sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Table"
                android:textColor="@color/lcd_menu_muted"
                android:textSize="8sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="Equation"
                android:textColor="@color/lcd_menu_muted"
                android:textSize="8sp" />
        </GridLayout>

        <View
            android:id="@+id/lcd_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="4dp"
            android:background="#6A7560"
            app:layout_constraintTop_toBottomOf="@id/lcd_menu_grid" />

        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/lcd_divider">

            <TextView
                android:id="@+id/indicator_shift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:textColor="@color/lcd_indicator"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="invisible"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/indicator_alpha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="A"
                android:textColor="@color/lcd_indicator"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="invisible"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEG"
                android:textColor="@color/lcd_indicator"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:textColor="@color/lcd_text"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/status_bar"
            tools:text="123 + 456" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textColor="@color/lcd_text"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tv_expression"
            tools:text="579" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_classwiz"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.25"
        android:text="CLASSWIZ"
        android:textColor="@color/text_brand"
        android:textSize="9sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screen_container" />

    <!-- Navigation Section -->
    <LinearLayout
        android:id="@+id/nav_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:gravity="top"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_classwiz">

        <!-- LEFT: ON, SETTINGS, SHIFT -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingEnd="3dp">

            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_on"
                style="@style/CasioButton.Nav"
                android:text="ON"
                android:textSize="7sp" />

            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_settings"
                style="@style/CasioButton.Nav"
                android:layout_marginTop="4dp"
                android:text="SETTINGS"
                android:textSize="7sp" />

            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_shift"
                style="@style/CasioButton.Shift"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:text="SHIFT"
                android:textSize="7sp" />
        </LinearLayout>

        <!-- CENTER: HOME + D-PAD -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_home"
                style="@style/CasioButton.Nav"
                android:text="HOME"
                android:textSize="7sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dpad_container"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="3dp">

                <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                    android:id="@+id/btn_ok"
                    style="@style/CasioButton.Dark"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="OK"
                    android:textSize="9sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/btn_up"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@android:string/untitled"
                    android:padding="3dp"
                    android:src="@android:drawable/arrow_up_float"
                    android:tint="@color/text_on_dark"
                    app:layout_constraintBottom_toTopOf="@id/btn_ok"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageButton
                    android:id="@+id/btn_down"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@android:string/untitled"
                    android:padding="3dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:tint="@color/text_on_dark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_ok" />

                <ImageButton
                    android:id="@+id/btn_left"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@android:string/untitled"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:tint="@color/text_on_dark"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_ok"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/btn_right"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@android:string/untitled"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_media_next"
                    android:tint="@color/text_on_dark"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/btn_ok"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <!-- RIGHT: SCROLL -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scroll_pill"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="3dp"
            android:paddingTop="4dp"
            android:paddingEnd="3dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btn_scroll_up"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/untitled"
                android:src="@android:drawable/arrow_up_float"
                android:tint="@color/text_on_dark" />

            <ImageButton
                android:id="@+id/btn_scroll_down"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/untitled"
                android:src="@android:drawable/arrow_down_float"
                android:tint="@color/text_on_dark" />
        </LinearLayout>
    </LinearLayout>

    <!-- Function Strip -->
    <LinearLayout
        android:id="@+id/function_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/nav_section">

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_back"
            style="@style/CasioButton.Dark"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:text="BACK"
            android:textSize="8sp" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_variable"
            style="@style/CasioButton.Dark"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:text="VARIABLE"
            android:textSize="8sp" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_function"
            style="@style/CasioButton.Dark"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:text="FUNCTION"
            android:textSize="8sp" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_catalog"
            style="@style/CasioButton.Dark"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:text="CATALOG"
            android:textSize="8sp" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_tools"
            style="@style/CasioButton.Dark"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_margin="1dp"
            android:layout_weight="1"
            android:text="TOOLS"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- Main Keypad Grid -->
    <GridLayout
        android:id="@+id/main_keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:columnCount="5"
        android:padding="1dp"
        android:rowCount="8"
        android:useDefaultMargins="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/function_strip">

        <!-- ROW 1: 1/x, ∫, √, ∛, □⁻¹ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR"
                android:textColor="#FFD700"
                android:textSize="6sp"
                android:textStyle="bold" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_reciprocal"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="1/x"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pre"
                android:textColor="#FFD700"
                android:textSize="6sp"
                android:textStyle="bold" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_integral"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="∫"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arc"
                android:textColor="#FFD700"
                android:textSize="6sp"
                android:textStyle="bold" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_sqrt"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="√"
                android:textSize="11sp" />
        </LinearLayout>

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_cbrt"
            style="@style/CasioButton.Dark"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:text="∛"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_inv"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="□⁻¹"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- ROW 2: π, sin, cos, tan, ( -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ans"
                android:textColor="#FFD700"
                android:textSize="6sp"
                android:textStyle="bold" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_pi"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="π"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="e"
                android:textColor="#FFD700"
                android:textSize="7sp"
                android:textStyle="bold" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_sin"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="sin"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_cos"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="cos"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_tan"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="tan"
                android:textSize="9sp" />
        </LinearLayout>

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_open_bracket"
            style="@style/CasioButton.Dark"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:text="("
            android:textSize="11sp" />

        <!-- ROW 3: sin⁻¹, cos⁻¹, tan⁻¹, log, ln -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_asin"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="sin⁻¹"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_acos"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="cos⁻¹"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_atan"
                style="@style/CasioButton.Dark"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="tan⁻¹"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="1dp"
            android:orientation="vertical"
            android:gravity="center">
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp" />
            <com.ptithcm.projectcalculater.ui.components.CalculatorButton
                android:id="@+id/btn_log"
                style="@style/CasioButton.Dark"
