<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/casio_body"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/screen_container"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_lcd_screen"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/indicator_shift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:textColor="@color/btn_shift"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="invisible"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/indicator_alpha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="A"
                android:textColor="@color/btn_alpha"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="invisible"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEG"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_expression"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:textColor="@color/lcd_text"
            android:textSize="22sp"
            app:layout_constraintBottom_toTopOf="@+id/tv_result"
            app:layout_constraintTop_toBottomOf="@id/status_bar" />

        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="bottom|end"
            android:text="0"
            android:textColor="@color/lcd_text"
            android:textSize="38sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:columnCount="5"
        android:rowCount="8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screen_container">

        <!-- Row 1 -->
        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_open_bracket"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="(" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_close_bracket"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text=")" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_sqrt"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="√" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_sqr"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="x²" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_pow"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="xⁿ" />

        <!-- Row 2 -->
        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_sin"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="sin" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_cos"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="cos" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_tan"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="tan" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_log"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="log" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_ln"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="ln" />

        <!-- Row 3 -->
        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_pi"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="π" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_frac"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="frac" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_deg"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="° ' &quot;" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_hyp"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="hyp" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_inv"
            style="@style/CasioButton.Function"
            android:layout_columnWeight="1"
            android:text="x⁻¹" />

        <!-- Row 4 -->
        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_7"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="7" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_8"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="8" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_9"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="9" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_del"
            style="@style/CasioButton.Operator"
            android:layout_columnWeight="1"
            android:text="DEL"
            app:backgroundTint="@color/btn_ac" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_ac"
            style="@style/CasioButton.Operator"
            android:layout_columnWeight="1"
            android:text="AC"
            app:backgroundTint="@color/btn_ac" />

        <!-- Row 5 -->
        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_4"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="4" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_5"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="5" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_6"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="6" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_mul"
            style="@style/CasioButton.Operator"
            android:layout_columnWeight="1"
            android:text="×" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_div"
            style="@style/CasioButton.Operator"
            android:layout_columnWeight="1"
            android:text="÷" />

        <!-- Row 6 -->
        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_1"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="1" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_2"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="2" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_3"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="3" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_add"
            style="@style/CasioButton.Operator"
            android:layout_columnWeight="1"
            android:text="+" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_sub"
            style="@style/CasioButton.Operator"
            android:layout_columnWeight="1"
            android:text="−" />

        <!-- Row 7 -->
        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_0"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="0" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_dot"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="." />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_exp_const"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="×10ⁿ" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_ans"
            style="@style/CasioButton.Number"
            android:layout_columnWeight="1"
            android:text="Ans" />

        <com.ptithcm.projectcalculater.ui.components.CalculatorButton
            android:id="@+id/btn_exe"
            style="@style/CasioButton.Operator"
            android:layout_columnWeight="1"
            android:text="EXE"
            app:backgroundTint="@color/btn_exec" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>